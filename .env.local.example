# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — .env.local ถูก gitignore ไว้แล้ว
# ห้ามใส่ค่าเหล่านี้ใน client component ทุกตัวเรียกจาก API route ฝั่งเซิร์ฟเวอร์เท่านั้น
# (ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ จะถูกฝังลงไปในเบราว์เซอร์ จึงใช้กับ key ไม่ได้)

# ---- Claude (ภารกิจ E3: AI Chat Buddy, ตรวจงาน, generate เนื้อหา) ----
ANTHROPIC_API_KEY=

# ---- Supabase (ภารกิจ E6: บัญชี ห้องเรียน ความคืบหน้า) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- บริการเสียง (ภารกิจ E4) ----
# เฟสเดโมยังไม่ต้องใส่ เพราะใช้ Web Speech API ของเบราว์เซอร์ซึ่งฟรี
# เมื่อตัดสินใจ D2 แล้วค่อยเติมส่วนนี้
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
